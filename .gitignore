# Diagnostic dumps — generated by `npm run tomato:snapshot` and
# `npm run plant:dump`. Scripts are tracked; outputs are not.
packages/tomato-engine/diagnostics/snapshots/
src/plant/__diag__/

# Growth Calibration Platform — reproducible run outputs (regen via scripts).
# Tracked: schema/ + reference/ + scripts/ + experiments/*/model-updates/
# Not tracked: simulation/ + comparison/ (rebuildable from scripts).
growth-calibration/experiments/*/simulation/
growth-calibration/experiments/*/comparison/

# Pre-refactor checkpoint snapshots — regenerable via
# `npx vite-node growth-calibration/scripts/dump-growth-checkpoints.ts`.
# 의사결정 기록은 docs/calibration-checkpoint-reports/ 에 별도 tracked.
growth-calibration/checkpoints/

# Iter audit summaries — regenerable via dump-iter-audit.ts.
# 의사결정 기록은 docs/calibration-checkpoint-reports/ 에 별도 tracked.
growth-calibration/audits/

# Gompertz parameter sweep outputs — regenerable via run-gompertz-sweep.ts.
# sweep_summary.json/md만 audit md에 inline 포함 (자동 generation).
growth-calibration/sweeps/

# Playwright outputs — screenshots/videos/traces regenerable from spec files.
test-results/
playwright-report/
docs/iter31/r26-cleanup-baseline.json
