  "env": { "manualHour": 11, "lightingPreset": "default", "wind": { "strength": 0.0, "direction": [0, 0, 0] } },
  "robot": { "model": "via-agv-6dof-v1", "startPose": { "rail": "aisle-3", "x": 4.2 }, "endEffector": "thinning-cutter" },
  "task": { "type": "thinning-decision", "speedMps": 0, "decisionTriggers": ["fruit-detected"], "targets": "truss==1 && diameterMm < 10", "rule": "첫 화방의 작은 과실 1개 제거" },
  "verify": {
    "successCriteria": [
      { "metric": "decision-accuracy", "min": 0.85 },
      { "metric": "reachability-rate", "min": 0.95 },
      { "metric": "task-completion-time", "max": 30 }
