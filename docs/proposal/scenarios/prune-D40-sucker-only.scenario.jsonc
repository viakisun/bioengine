{
  // Phytosim Scenario · Pruning (적심·곁순 제거), Day 40, Sucker only
  // 초중기 생육 (D40) — 곁순(side shoot) 제거 의사결정.
  "id": "prune-D40-sucker-only",
  "version": "1.0",
  "domain": "pruning",
  "consumableBy": ["Workbench"],

  "world": {
    "greenhouseConfig": "default-24x34-13beds",
    "activeBeds": [3],
    "plantPlacement": "single-plant-D40"
  },

  "crop": {
    "day": 40,
    "seed": "0x3F40",
    "cultivar": "tomimaru",
    "perturbation": {
      "leafDensityScale": 1.0,
      "internodeScale": 1.0,
      "trussTimingOffset": 0,
      "fruitSetRate": 1.0
    }
  },

  "env": {
    "manualHour": 10,
    "lightingPreset": "default",
    "wind": { "strength": 0.0, "direction": [0, 0, 0] },
    "fogDensity": 0
  },

  "robot": {
    "model": "via-agv-6dof-v1",
    "startPose": { "rail": "aisle-3", "x": 4.2 },
    "endEffector": "thinning-cutter",                      // 곁순 절단도 동일 도구
    "camera": {
      "head": { "lens": 45, "mountHeight": 1.4, "pitch": 0, "yaw": 0 },
      "endEffector": { "lens": 30, "mountHeight": 1.3, "pitch": 0, "yaw": 0 }
    }
  },

  "task": {
    "type": "pruning-sucker",
    "speedMps": 0,
    "decisionTriggers": ["sucker-detected"],
    "targets": "isSideShoot && parentAxisIdx==0 && budState=='growing'",
    "rule": "주줄기에 직접 붙은 곁순 중 활성 상태(growing)인 것을 제거"
  },

  "verify": {
    "successCriteria": [
      { "metric": "decision-accuracy",    "min": 0.90, "note": "곁순 식별은 비교적 명확" },
      { "metric": "reachability-rate",    "min": 0.95 },
      { "metric": "mask-iou",             "min": 0.80 },
      { "metric": "task-completion-time", "max": 20 }
    ]
  },

  "meta": {
    "parentId": null,
    "createdBy": "via-pm",
    "createdAt": "2026-06-06T10:00:00Z",
    "description": "초중기 곁순 제거. 작업 후 식물 상태 budState='pruned' 동기 검증."
  }
}
