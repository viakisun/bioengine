{
  // S2.e — 잎에 가려진 과실 적과 의사결정 (occlusion-aware).
  "id": "thin-occluded-fruit",
  "version": "1.0",
  "domain": "thinning",
  "consumableBy": ["Workbench"],
  "world": { "greenhouseConfig": "default-24x34-13beds", "activeBeds": [3], "plantPlacement": "single-plant-D80" },
  "crop": { "day": 80, "seed": "0x8077", "cultivar": "tomimaru", "perturbation": { "leafDensityScale": 1.3 } },
  "env": { "manualHour": 11, "lightingPreset": "default", "wind": { "strength": 0.0, "direction": [0, 0, 0] } },
  "robot": { "model": "via-agv-6dof-v1", "startPose": { "rail": "aisle-3", "x": 4.2 }, "endEffector": "thinning-cutter" },
  "task": { "type": "thinning-decision", "speedMps": 0, "decisionTriggers": ["fruit-detected"], "targets": "occlusion > 0.5 && truss>=3", "rule": "가림 50% 초과 과실은 시야 확보 우선 제거" },
  "verify": {
    "successCriteria": [
      { "metric": "decision-accuracy", "min": 0.80 },
      { "metric": "occlusion-error", "max": 0.15 }
    ]
  },
  "meta": { "parentId": null, "createdBy": "via-pm", "createdAt": "2026-06-06T10:00:00Z", "description": "잎 가림 과실 적과 의사결정." }
}
