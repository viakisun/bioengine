{
  // S1.g — 다중 베드 전환 (베드 간 hairpin 통과).
  "id": "drive-multi-bed-traverse",
  "version": "1.0",
  "domain": "autonomous-driving",
  "consumableBy": ["Twin"],
  "world": { "greenhouseConfig": "default-24x34-13beds", "activeBeds": [3, 4, 5, 6, 7], "plantPlacement": "showcase-D60" },
  "crop": { "day": 60, "seed": "0x6001", "cultivar": "tomimaru" },
  "env": { "manualHour": 11, "lightingPreset": "default", "wind": { "strength": 0.15, "direction": [1, 0, 0.1] } },
  "robot": { "model": "via-agv-6dof-v1", "startPose": { "rail": "aisle-3", "x": 0.0 }, "endEffector": "none" },
  "task": { "type": "drive-traverse", "speedMps": 0.25, "decisionTriggers": ["obstacle", "bed-transition"] },
  "verify": {
    "successCriteria": [
      { "metric": "fov-fruit-coverage", "min": 0.7 },
      { "metric": "collision-count", "max": 0 },
      { "metric": "path-length", "max": 80.0 }
    ]
  },
  "meta": { "parentId": null, "createdBy": "via-pm", "createdAt": "2026-06-06T10:00:00Z", "description": "다중 베드 전환 (hairpin 포함)." }
}
