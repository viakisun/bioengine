{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2020"],
    "baseUrl": ".",
    "paths": {
      "@farmsim/tomato-engine": ["../tomato-engine/src"],
      "@farmsim/tomato-engine/*": ["../tomato-engine/src/*"]
    }
  },
  "include": ["src"]
}
