// Tomato Botanical Parameters — botanical.v1 family
//
// 본 파일은 모든 tomato cultivar 공통 botanical parameter default.
// cultivar는 cultivars/*.jsonc 의 botanicalOverride 로 partial override만.
//
// SSOT #26 (botanical layer separation):
//   Engine 코드(.ts)에 hardcoded numeric literal 금지.
//   모든 작물별 botanical/physiological parameter는 본 파일에서.
//
// SSOT #29 (layer boundary):
//   - botanical (this file): stem geometry / internode / fruit growth curve / leaf morphology
//   - phenology (cultivar.phenology): GDD_to_first_flower, GDD_per_truss, etc.
//   - canopy physiology (tomgro-v1.jsonc): photosynthesis, LUE, sink, LAI cap
//   - physics (separate): stem radius, cambial growth
//
// SSOT #30 (per-field enforcement):
//   각 field의 active/pending_engine_logic/deprecated 상태를 enforcementStatus에 명시.
//   inactive field 도 spec에 포함하되 enforcementStatus: 'pending_engine_logic' 필수.
//
// References (provenance):
//   - Heuvelink E. (2018) Tomato 2nd ed. CABI
//   - De Koning ANM (1994) PhD thesis, Wageningen
//   - Gillaspy G. et al. (1993) Plant Cell 5:1439-1451 (Fruit growth phases)
//   - Marcelis LFM & Heuvelink E. (1996) sink strength
//   - RDA 농촌진흥청 토마토 표준재배지침 (2020)
//   - Anaya-Ramirez (2024) Gompertz fruit growth fits

{
  "schemaVersion": "botanical.v1",
  "crop": "tomato",

  "provenance": {
    "sourceLevel": "literature",
    "confidence": "medium",
    "sourceRefs": [
      "Heuvelink 2018 Tomato 2nd ed. CABI",
      "De Koning 1994 PhD Wageningen",
      "Gillaspy 1993 Plant Cell 5:1439-1451",
      "Marcelis Heuvelink 1996",
      "RDA 2020 토마토 표준재배지침",
      "Anaya-Ramirez 2024 Gompertz fits",
      "Migrated from packages/tomato-engine/src/GrowthModel.ts:617-700 (commit e0b688e baseline)",
      "Migrated from packages/tomato-engine/src/PlantGenome.ts:63-110",
      "Migrated from packages/tomato-engine/src/FruitGrowth.ts:51"
    ],
    "notes": "Phase 1 migration (2026-05-25). 25 hardcoded values moved from engine code to JSONC. Functional equivalence maintained — values are exact mirror of baseline. Future calibration via JSONC override (cultivar.botanicalOverride).",
    "lastReviewed": "2026-05-25"
  },

  // ============================================================
  // STEM GROWTH (Table 1, 17 values)
  // ============================================================
  "stemGrowth": {

    // -- Hypocotyl (싹의 줄기 부분, 발아 후 신장) --------------
    // GrowthModel.ts:640: hypocotylCm = day < 5 ? 0 : Math.min(4, (day - 5) * 0.8)
    "hypocotyl": {
      "emergenceDay": 5,                    // 발아 5일 후 신장 시작
      "maxCm": 4,                            // 4cm 도달 후 정지
      "growthRateCmPerDay": 0.8              // Heuvelink 2018 Ch.4
    },

    // -- Seedling internode (어린 절간 패턴) -----------------------
    // GrowthModel.ts:652-654:
    //   if (i === 0) finalLen = 1.5
    //   else if (i < 4) finalLen = 1.5 + i * 0.8
    "seedlingInternode": {
      "count": 4,                            // 첫 4개 노드는 정해진 패턴
      "firstLenCm": 1.5,                     // 절간 0 = 1.5cm
      "slopePerNode": 0.8                    // i × 0.8cm 증가 (i=1→2.3, i=2→3.1, i=3→3.9)
    },

    // -- Mature internode (성숙 절간, vigor + taper) ----------------
    // GrowthModel.ts:663-665:
    //   finalLen = baseInternode * (0.75 + 0.5 * vigor)
    //   if (nodeFrac > 0.8) finalLen *= 1.0 - (nodeFrac - 0.8) * 0.5
    // PlantGenome.ts:101 (current latest, after height fix):
    //   internodeLenCm: clamp(rng.gaussian(8.0, 0.8), 6.0, 10.5)
    "matureInternode": {
      "vigorFloor": 0.75,                    // off-peak 노드도 75% elongation (P0 fix)
      "vigorRange": 0.5,                     // peak에서 1.25× 도달
      "taperStartFrac": 0.8,                 // 상부 80% 위 노드부터 taper
      "taperSlope": 0.5,                     // taper 시 절간 길이 50% 감소
      "lengthDistribution": {                // PlantGenome internodeLenCm gaussian
        "mu": 8.0,                           // Reference Pack 285cm/34nodes ≈ 8.4cm/internode
        "sigma": 0.8,
        "min": 6.0,
        "max": 10.5
      }
    },

    // -- Elongation (GA-mediated delayed sigmoid) -----------------
    // GrowthModel.ts:636,658-661:
    //   ELONG_K = 0.4
    //   elongation = elongAge <= 0 ? 0.01 : sigmoid(elongAge, ELONG_K, elongMid)
    // PlantGenome.ts:106-108:
    //   internodeElongDelay: clamp(rng.gaussian(4.0, 0.5), 3, 6)
    //   internodeElongMid: clamp(rng.gaussian(8, 1.0), 6, 10)
    "elongation": {
      "steepness": 0.4,                      // sigmoid k
      "delayDays": {                         // 잎 신장 → GA → 절간 신장 lag
        "mu": 4.0,
        "sigma": 0.5,
        "min": 3,
        "max": 6
      },
      "midpointDays": {                      // sigmoid 중간점 (~8일 후 50% elongation)
        "mu": 8.0,
        "sigma": 1.0,
        "min": 6,
        "max": 10
      },
      "preElongFactor": 0.01                 // pre-elongation factor (~1% of finalLen 압축 primordium)
    },

    // -- Height curve (overall plant height sigmoid) ----------------
    // PlantGenome.ts:63-65:
    //   heightMaxCm: clamp(rng.gaussian(200, 15), 160, 240)
    //   heightSigmoidK: clamp(rng.gaussian(0.07, 0.008), 0.04, 0.10)
    //   heightSigmoidMid: clamp(rng.gaussian(45, 4), 35, 55)
    "heightCurve": {
      "sigmoidK": {
        "mu": 0.07,
        "sigma": 0.008
      },
      "sigmoidMid": {
        "mu": 45,
        "sigma": 4
      },
      "maxCm": {
        "mu": 200,
        "sigma": 15,
        "min": 160,
        "max": 240
      }
    },

    // -- Initial state (정식묘 nodeDayOf offset) -------------------
    // GrowthModel.ts:609 (height fix commit e0b688e):
    //   if (i < initialN) return -30 + i * 0.5
    // 4주 묘 정식 = 5-7 leaf 모두 expanded. 5개 초기 node를 -30~-28일로 spread → 모두 elongated at day 0.
    "initialStateOffsetDays": -30,
    "initialStateSpread": 0.5                // i=0 → -30, i=4 → -28
  },

  // ============================================================
  // FRUIT DEVELOPMENT (Table 3, 8 values)
  // ============================================================
  "fruitDevelopment": {

    // -- Visual sigmoid (legacy visual fruit path) ----------------
    // GrowthModel.ts:625-626. Phase 1.1 calibration (growth_update_004,
    // 2026-05-25): midpointDays 18→22, steepness 0.12→0.10 to address
    // Reference Pack diagnoses tomato_fruit_appears_too_early (60/220)
    // + tomato_day33_fruit_too_early (20/20). Playwright day30 truss
    // closeup showed visible 3cm fruits at day 30 (target 0).
    // Same category (fruit_growth_curve), SSOT #32 ≤3 param iteration.
    "visualSigmoid": {
      "steepness": 0.10,
      "midpointDays": 22
    },

    // -- Ripening (성숙 단계) -------------------------------------
    // GrowthModel.ts:627-628:
    //   RIPEN_START_AGE = 25
    //   RIPEN_DURATION = 18
    "ripening": {
      "startAgeDays": 25,                    // 착과 후 25일에 ripening 시작
      "durationDays": 18                     // breaker → red 18일
    },

    // -- Flowering (꽃 → 착과 timing) -----------------------------
    // GrowthModel.ts:840-845:
    //   flower delay per position = 2 (truss 안 꽃 간격)
    //   flower bloom time = 5
    //   fruit set delay post-bloom = 12
    "flowering": {
      "delayPerPositionDays": 2,             // 같은 truss 안 꽃 발생 간격
      "bloomDurationDays": 5,                // 개화 지속
      // NOTE: setDelayDays(12)는 현재 엔진(CoreModel.ts:320-327)이 anthesis 즉시
      // set 처리. inactive value. Phase 1은 location migration만, 실제 enforcement는
      // 별도 Iter 1B engine_logic plan에서. enforcementStatus 참조.
      "setDelayDays": 12
    },

    // -- Gompertz fruit growth curve -----------------------------
    // Gillaspy 1993 3-phase fruit growth + Gompertz fit.
    // FruitGrowth.ts:51: exponent scaling 0.01
    // cultivar.physiology.gompertz* (이동 대상, tomimaru는 0.05/0.55):
    //   rateB: 0.06
    //   inflectionC: 0.45
    "gompertz": {
      // Iter 6 (growth_update_006): inflectionC.mu 0.45→1.00, rateB.mu 0.06→0.05, exp 0.01→0.12.
      // Iter 6b (growth_update_007): top 4 sweep candidate re-evaluation 결과 run_005 선택.
      //   rateB.mu 0.05 → 0.06 (살짝 빠르게 — fruit stage 진행 가속)
      //   exponentScaling 0.12 → 0.08 (curve 살짝 평탄화)
      // 결과 (220 comparison, baseline v0.11):
      //   truss_status_too_behind 97 → 87 (-10), Day 90 visible 6 → 8 (+2)
      //   S 0.693 → 0.694, P_band 0.550 → 0.554
      //   Day 30/33 maxDiam 0.0mm 유지 (hard gate pass)
      //   Day 60 27.7 → 32.0mm, Day 90 56.2 → 55.0mm (target band 유지)
      "rateB": {                             // 1/GDD, growth rate parameter
        "mu": 0.06,
        "sigma": 0.01
      },
      "inflectionC": {                       // ratio, τ/total inflection point
        "mu": 1.00,
        "sigma": 0.05
      },
      "exponentScaling": 0.10                // FruitGrowth.ts (Iter 6k growth_update_017 — 0.08→0.10, D33 fruit_too_early 보호 + lag/fSR 결합 활성화)
    },

    // -- Mass flow policy (Iter 5b, growth_update_005) -----------
    // Reference Pack v0.9 진단 결과 Case B fired: 모든 day에서 fruit
    // mass cap 도달 (Day 30 87mm, Day 60 87mm, Day 90 90mm). 원인은
    // CoreModel:435-436의 시간 무관 W_dry_cap. 본 block은 Gompertz
    // potential mass curve를 (a) per-step sink demand limit + (b)
    // cumulative trajectory cap 두 곳에 연결하는 engine_logic 정책.
    "massFlow": {
      "mode": "gompertz_sink_limited",       // legacy_sink_unlimited 는 fallback
      "fruitDryMatterRatio": 0.06,           // Heuvelink 1996 0.05-0.07
      "minVisibleDiameterMm": 3,             // Iter 6: 2→3. visibleFruitCount 임계값.
                                              //   SSOT #42 — calibration pass와 동일 값.
      "minExpandingDiameterMm": 10,          // Iter 6 신규. truss 'fruit_expanding' 임계값.
                                              //   phase ∈ {cell_expansion, ripening_*} 도 함께 확인.
      "enableTrajectoryCap": true,           // cumulative W_dry trajectory cap
      "enableStepDemandLimit": true,         // per-fruit per-step demand clamp
      "surplusPolicy": "unused_pool",        // clamp surplus는 vegetative로 안 흐름. Iter 6e-2: 'fruit_priority_limited' 옵트인 가능.
      // Iter 6e-2 (SSOT #85): fruit_priority_limited 정책에서 surplus의 몇 %를 fruit에 재분배할지.
      //   default 0.5. surplusPolicy != 'fruit_priority_limited'이면 무시.
      "fruitPriorityRedistributionFraction": 0.5,
      // Iter 6e-3 (SSOT #87): phase-aware per-fruit step demand cap multiplier.
      //   cellDivision 풀면 Day 30/33 fruit_too_early 위험 (SSOT #88) → 1.0 권장.
      //   cellExpansion/ripening만 풀어서 Day 60/90 fruit이 더 받음.
      //   default 모두 1.0 (현재 stepCap 그대로, 후방호환).
      "capRelaxationByPhase": {
        "cellDivision": 1.0,
        "cellExpansion": 1.0,
        "ripening": 1.0
      },
      // Iter 7b (SSOT #103/#104/#105): phase-aware fruit mass growth refactor.
      //   cell_division 단계 mass growth 강하게 제한 + cell_expansion 빠른 accumulation 허용.
      //   default enabled=false → behavior unchanged (v0.11.3 baseline 동일, 후방호환).
      //   promote 시 enabled=true + winner values 갱신.
      //   ⚠ dry mass clamp PRIMARY (biology-level), diameter clamp SAFETY (warning if triggered).
      "phaseAwareMassGrowth": {
        "enabled": false,
        "divisionPhaseMassFraction": 0.03,
        "divisionPhaseMaxDiameterMm": 3,
        "expansionPhaseGrowthMultiplier": 1.0,
        "ripeningPhaseGrowthMultiplier": 0.8,
        // Iter 7c (SSOT #106/#107): cumulative Gompertz cap clock 기준.
        //   'fertilization_based' (default, 후방호환): Iter 5b/7b 동작 유지.
        //   'expansion_start_based' (Iter 7c neue): cell_expansion 진입 후 effective GDD shift.
        //   enabled=true AND expansionClockMode='expansion_start_based' 동시 필요.
        "expansionClockMode": "fertilization_based"
      },
      "debug": true,                         // snapshot에 debug fields 출력
      // Iter 6h (SSOT #74, #76): visibility gate — calibration-only.
      //   diameter_only: 기본 (v0.11.1 후방호환). Iter 6h sweep으로 phase/phase_and_gdd 평가.
      "visibilityGateMode": "diameter_only",
      "minFruitAgeGDDForVisible": 80         // visibilityGateMode='phase_and_gdd'일 때만 활성
    }
  },

  // ============================================================
  // Lite field-level provenance (parameterNotes) — 사용자 검토 #4
  // ============================================================
  "parameterNotes": {
    "stemGrowth.matureInternode.lengthDistribution":
      "Migrated from PlantGenome.ts:101 (height fix commit e0b688e). mu 6.5→8.0 tuned against Reference Pack v0.1 (285cm/34nodes ≈ 8.4cm/internode).",
    "stemGrowth.initialStateOffsetDays":
      "Height fix (commit e0b688e). 정식묘 5 nodes를 -30 ~ -28일 spread해서 day 0에 fully elongated 상태로 시작.",
    "stemGrowth.heightCurve.maxCm":
      "Migrated from PlantGenome.ts:63. cultivar별 calibration 가능 (cherry는 작고 beefsteak는 큼).",
    "fruitDevelopment.flowering.setDelayDays":
      "INACTIVE — 엔진(CoreModel.ts:320-327)이 anthesis 즉시 set 처리. 별도 Iter 1B engine_logic plan에서 enforcement.",
    "fruitDevelopment.gompertz":
      "Gillaspy 1993 3-phase fruit growth Gompertz fit. cultivar.botanicalOverride.fruitDevelopment.gompertz로 cultivar 보정 가능 (tomimaru 0.05/0.55 등).",
    "fruitDevelopment.massFlow":
      "Iter 5b engine_logic. Reference Pack v0.9 진단 Case B (fruit cap 폭주) 대응. CoreModel sink + W_dry_cap을 Gompertz trajectory에 연결. surplusPolicy 'unused_pool'은 fruit fix 단독 측정용 (잉여 DM은 vegetative로 안 흐름)."
  },

  // ============================================================
  // Per-field enforcement status — 사용자 검토 #2
  // ============================================================
  "enforcementStatus": {
    "stemGrowth.hypocotyl.emergenceDay": "active",
    "stemGrowth.hypocotyl.maxCm": "active",
    "stemGrowth.hypocotyl.growthRateCmPerDay": "active",
    "stemGrowth.seedlingInternode.count": "active",
    "stemGrowth.seedlingInternode.firstLenCm": "active",
    "stemGrowth.seedlingInternode.slopePerNode": "active",
    "stemGrowth.matureInternode.vigorFloor": "active",
    "stemGrowth.matureInternode.vigorRange": "active",
    "stemGrowth.matureInternode.taperStartFrac": "active",
    "stemGrowth.matureInternode.taperSlope": "active",
    "stemGrowth.matureInternode.lengthDistribution": "active",
    "stemGrowth.elongation.steepness": "active",
    "stemGrowth.elongation.delayDays": "active",
    "stemGrowth.elongation.midpointDays": "active",
    "stemGrowth.elongation.preElongFactor": "active",
    "stemGrowth.heightCurve.sigmoidK": "active",
    "stemGrowth.heightCurve.sigmoidMid": "active",
    "stemGrowth.heightCurve.maxCm": "active",
    "stemGrowth.initialStateOffsetDays": "active",
    "stemGrowth.initialStateSpread": "active",

    "fruitDevelopment.visualSigmoid.steepness": "active",
    "fruitDevelopment.visualSigmoid.midpointDays": "active",
    "fruitDevelopment.ripening.startAgeDays": "active",
    "fruitDevelopment.ripening.durationDays": "active",
    "fruitDevelopment.flowering.delayPerPositionDays": "active",
    "fruitDevelopment.flowering.bloomDurationDays": "active",
    "fruitDevelopment.flowering.setDelayDays": "pending_engine_logic",
    "fruitDevelopment.gompertz.rateB": "active",
    "fruitDevelopment.gompertz.inflectionC": "active",
    "fruitDevelopment.gompertz.exponentScaling": "active",
    "fruitDevelopment.massFlow.mode": "active",
    "fruitDevelopment.massFlow.fruitDryMatterRatio": "active",
    "fruitDevelopment.massFlow.minVisibleDiameterMm": "active",
    "fruitDevelopment.massFlow.minExpandingDiameterMm": "active",
    "fruitDevelopment.massFlow.enableTrajectoryCap": "active",
    "fruitDevelopment.massFlow.enableStepDemandLimit": "active",
    "fruitDevelopment.massFlow.surplusPolicy": "active",
    "fruitDevelopment.massFlow.fruitPriorityRedistributionFraction": "active",
    "fruitDevelopment.massFlow.capRelaxationByPhase": "active",
    "fruitDevelopment.massFlow.capRelaxationByPhase.cellDivision": "active",
    "fruitDevelopment.massFlow.capRelaxationByPhase.cellExpansion": "active",
    "fruitDevelopment.massFlow.capRelaxationByPhase.ripening": "active",
    "fruitDevelopment.massFlow.phaseAwareMassGrowth": "active",
    "fruitDevelopment.massFlow.phaseAwareMassGrowth.enabled": "active",
    "fruitDevelopment.massFlow.phaseAwareMassGrowth.divisionPhaseMassFraction": "active",
    "fruitDevelopment.massFlow.phaseAwareMassGrowth.divisionPhaseMaxDiameterMm": "active",
    "fruitDevelopment.massFlow.phaseAwareMassGrowth.expansionPhaseGrowthMultiplier": "active",
    "fruitDevelopment.massFlow.phaseAwareMassGrowth.ripeningPhaseGrowthMultiplier": "active",
    "fruitDevelopment.massFlow.phaseAwareMassGrowth.expansionClockMode": "active",
    "fruitDevelopment.massFlow.visibilityGateMode": "active",
    "fruitDevelopment.massFlow.minFruitAgeGDDForVisible": "active",
    "fruitDevelopment.massFlow.debug": "active"
  }
}
