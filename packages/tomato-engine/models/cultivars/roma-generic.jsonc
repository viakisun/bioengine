// Roma (paste) tomato — generic profile (literature-based).
// ~80g, 2 locules, *elongated* (H:W > 1) — unique among the 5 baselines.

{
  "layer": "cultivar",
  "crop": "tomato",
  "metadata": {
    "name": "roma-generic",
    "type": "roma",
    "source": "literature"
  },

  "phenology": {
    "GDD_to_first_flower": 250,
    "GDD_per_truss": 120,
    "GDD_flower_to_red": 800,
    "cellDivisionDurationGDD": 150,
    "cellExpansionDurationGDD": 500,
    "ripeningDurationGDD": 200,
    "trussRipeningSpreadGDD": 75
  },

  "flowersPerTruss": { "mu": 7, "sigma": 1.5 },
  "fruitSetRate": 0.7,
  "potentialFruitMassG": { "mu": 80, "sigma": 15 },

  "morphology": {
    "firstTrussNodeIdx": { "mu": 9, "sigma": 1.0 },
    "trussIntervalNodes": 3,
    // Transitional. Roma 80g elongated ≈ 50mm equatorial (60mm length).
    "fruitMaxDiameterMm": { "mu": 50, "sigma": 5 },
    "loculeCount": { "mu": 2.0, "sigma": 0.4 },
    // > 1 = elongated (paste-tomato character), NOT oblate
    "heightWidthRatio": { "mu": 1.6, "sigma": 0.1 },
    "ribbingStrength": { "mu": 0.08, "sigma": 0.05 },
    "asymmetryStrength": 0.06,
    "blossomEndAdvanceFrac": { "mu": 0.4, "sigma": 0.1 }
  },

  "color": {
    "fullRipeRGB": [195, 35, 25],
    "greenStageRGB": [45, 118, 32],
    "hueVariance": 0.04
  },

  "pruning": {
    "defoliationAggressiveness": 0.4,
    "trussTargetFruitCount": 6
  },

  "physiology": {
    "SLA_m2_per_g": 0.028,
    "sinkStrength": { "leaf": 0.35, "stem": 0.15, "root": 0.07 },
    "gompertzRateB": 0.06,
    "gompertzInflectionC": 0.45
  },

  "reproductive": {
    "trussOrderProfile": [
      { "minOrder": 1, "maxOrder": null,
        "flowersPerTruss": { "mu": 7, "sigma": 1.5 },
        "targetFruitCount": 6, "potentialMassMultiplier": 1.0 }
    ]
  },
  "scenarios": {
    "commercial-standard": {
      "metadata": { "label": "Commercial paste", "intendedUse": "production_like", "notForYieldPrediction": false },
      "management": {
        "fruitPruning":  { "enabled": true },
        "defoliation":   { "enabled": true, "keepTrussesAboveRedTopmost": 3, "keepLeavesPerTruss": 0 },
        "harvest":       { "enabled": true, "atRipenStage": 5 }
      }
    }
  },

  // Plant Morphology Engine — Leaf Module v0.1 (leafShape.v1).
  // estimated/low provenance — replace with measured values in M1 calibration.
  "leafShape": {
    "schemaVersion": "leafShape.v1",
    "provenance": {
      "sourceLevel": "estimated",
      "confidence": "low",
      "sourceRefs": [],
      "notes": "Roma (paste): medium-narrow leaflets, modest rachis. v0.1 골격값.",
      "lastReviewed": "2026-05-25"
    },
    "widthProfile": {
      "mode": "beta",
      "peakHalfWidthM": 0.035,
      "peakT": 0.34,
      "sharpness": 4.8,
      "asymmetry": 1.0
    },
    "marginProfile": {
      "serrationDepth": 0.15,
      "serrationFrequency": 9,
      "lobeDepth": 0.06,
      "waviness": 0.04
    },
    "rachisLengthM": 0.28,
    "leafletAspect": 2.0
  },

  // Botanical layer override (botanical.v1). Phase 1: empty — roma uses
  // the default tomato botanical (ACTIVE_BOTANICAL.tomato) as-is.
  "botanicalOverride": {},

  // Iter 29 Phase 1-Pre — cultivar growth profile (TT-based).
  // Schema: CultivarGrowthProfile in src/Cultivar.ts.
  // Roma (determinate paste type): mid leaves, earlier truss, 9 leaflets.
  "growthProfile": {
    "phyllochronTT": 36,                   // slightly faster (determinate)
    "plastochronTT": 28,
    "baseInternodeLengthCm": 6,
    "maxLeafAreaCm2": 650,
    "maxLeafletCount": 9,
    "leafExpansionDurationTT": 380,
    "leafLifespanTT": 1100,
    "firstTrussNodeIndex": 7,              // determinate trusses earlier
    "trussIntervalNodes": 3,
    "baseStemRadiusMm": 7,
    "sourceSinkSensitivity": 0.38,
    // Iter 36 v5 Phase F — roma (determinate paste): 빠른 turnover, mature 우세.
    "leafPresetDistribution": {
      "young":        0.25,
      "mature":       0.60,
      "old":          0.10,
      "complex":      0.05,
      "potato-leaf":  0
    },
    // Iter 38 S4 — roma (paste type): 가장 길쭉 (plum-shaped fruit과 매칭).
    "leafShapeOverride": {
      "aspectRatioMultiplier": 1.25,    // 가장 길쭉
      "baseShapeBias":         -0.03,
      "tipSharpnessMultiplier": 1.05
    }
  }
}
