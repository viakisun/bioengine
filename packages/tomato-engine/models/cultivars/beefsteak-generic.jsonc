// Beefsteak tomato — generic profile (literature-based).
// Large ~280g, ~7 locules, strongly oblate + deep ribbing.

{
  "metadata": {
    "name": "beefsteak-generic",
    "type": "beefsteak",
    "source": "literature",
    "references": ["PMC10482247 — beefsteak locule QTL"]
  },

  "phenology": {
    "GDD_to_first_flower": 250,
    "GDD_per_truss": 120,
    "GDD_flower_to_red": 800,
    "cellDivisionDurationGDD": 150,
    "cellExpansionDurationGDD": 500,
    "ripeningDurationGDD": 200,
    "trussRipeningSpreadGDD": 110
  },

  "flowersPerTruss": { "mu": 5, "sigma": 1.2 },
  "fruitSetRate": 0.55,
  "potentialFruitMassG": { "mu": 280, "sigma": 50 },

  "morphology": {
    "firstTrussNodeIdx": { "mu": 10, "sigma": 1.0 },
    "trussIntervalNodes": 3,
    // Transitional. Beefsteak 280g ≈ 90mm equatorial.
    "fruitMaxDiameterMm": { "mu": 92, "sigma": 9 },
    "loculeCount": { "mu": 7.0, "sigma": 1.5 },
    "heightWidthRatio": { "mu": 0.7, "sigma": 0.06 },
    "ribbingStrength": { "mu": 0.55, "sigma": 0.12 },
    "asymmetryStrength": 0.12,
    "blossomEndAdvanceFrac": { "mu": 0.5, "sigma": 0.1 }
  },

  "color": {
    "fullRipeRGB": [200, 40, 30],
    "greenStageRGB": [50, 115, 38],
    "hueVariance": 0.06
  },

  "pruning": {
    "defoliationAggressiveness": 0.3,
    "trussTargetFruitCount": 3
  },

  "physiology": {
    "SLA_m2_per_g": 0.028,
    "sinkStrength": { "leaf": 0.35, "stem": 0.15, "root": 0.07 },
    "gompertzRateB": 0.06,
    "gompertzInflectionC": 0.45
  },

  "reproductive": {
    "trussOrderProfile": [
      { "minOrder": 1, "maxOrder": null,
        "flowersPerTruss": { "mu": 5, "sigma": 1.2 },
        "targetFruitCount": 3, "potentialMassMultiplier": 1.0 }
    ]
  },
  "scenarios": {
    "commercial-standard": {
      "metadata": { "label": "Commercial heavy pruning", "intendedUse": "production_like", "notForYieldPrediction": false },
      "management": {
        "fruitPruning":  { "enabled": true },
        "defoliation":   { "enabled": true, "keepTrussesAboveRedTopmost": 3, "keepLeavesPerTruss": 0 },
        "harvest":       { "enabled": true, "atRipenStage": 5 }
      }
    }
  },

  // Plant Morphology Engine — Leaf Module v0.1 (leafShape.v1).
  // estimated/low provenance — replace with measured values in M1 calibration.
  "leafShape": {
    "schemaVersion": "leafShape.v1",
    "provenance": {
      "sourceLevel": "estimated",
      "confidence": "low",
      "sourceRefs": [],
      "notes": "Beefsteak: large, wide leaflets, long rachis. v0.1 골격값.",
      "lastReviewed": "2026-05-25"
    },
    "widthProfile": {
      "mode": "beta",
      "peakHalfWidthM": 0.060,
      "peakT": 0.38,
      "sharpness": 4.0,
      "asymmetry": 1.0
    },
    "marginProfile": {
      "serrationDepth": 0.20,
      "serrationFrequency": 8,
      "lobeDepth": 0.08,
      "waviness": 0.06
    },
    "rachisLengthM": 0.42,
    "leafletAspect": 1.5
  },

  // Botanical layer override (botanical.v1). Phase 1: empty — beefsteak uses
  // the default tomato botanical (ACTIVE_BOTANICAL.tomato) as-is.
  "botanicalOverride": {},

  // Iter 29 Phase 1-Pre — cultivar growth profile (TT-based).
  // Schema: CultivarGrowthProfile in src/Cultivar.ts.
  // Beefsteak: large leaves (750-950 cm² range), 11 leaflets, longer
  // internodes, thicker stem.
  "growthProfile": {
    "phyllochronTT": 40,                   // slightly slower
    "plastochronTT": 32,
    "baseInternodeLengthCm": 8,
    "maxLeafAreaCm2": 850,                 // large beefsteak
    "maxLeafletCount": 11,
    "leafExpansionDurationTT": 450,        // slower expansion (larger leaf)
    "leafLifespanTT": 1300,
    "firstTrussNodeIndex": 10,
    "trussIntervalNodes": 3,
    "baseStemRadiusMm": 10,
    "sourceSinkSensitivity": 0.40,         // larger fruit → higher sink draw
    "droopSensitivity": 1.4                // heavy blade, strong droop
  }
}
