// Tomimaru Muchoo — F1 pink beefsteak (Sakata Seeds)
// 180-230g, popular Korean smart-farm cultivar.
//
// Tuning notes:
//   - heightWidthRatio.sigma 0.06 → 0.09  (wider σ for visible H:W variance)
//   - ribbingStrength.mu 0.35 → 0.55     (deeper lobes — pronounced ridges)
//   - asymmetryStrength 0.10 → 0.13      (more per-fruit individuality)

{
  "metadata": {
    "name": "tomimaru-muchoo",
    "type": "beefsteak",
    "source": "vendor",
    "supplier": "Sakata Seeds",
    "references": [
      "Sakata Seeds product spec",
      "K-smartfarm extension service",
      "Johnny's Selected Seeds catalog"
    ]
  },

  "phenology": {
    // GDD thresholds (CROPGRO-Tomato standard at T_base=10°C).
    //
    // Iter 1A (2026-05-25, growth_update_001): GDD_to_first_flower 250→300
    // per Reference Pack 08_day_gdd_mapping.json — user target firstVisible
    // TrussDay=25 days × 12 GDD/day at 22°C = 300. Original 250 → day 21,
    // ~4 days too early. Citation: RDA 2020 §3 + user_target_v0.1.
    "GDD_to_first_flower": 300,
    "GDD_per_truss": 120,
    "GDD_flower_to_red": 800,
    "cellDivisionDurationGDD": 150,
    "cellExpansionDurationGDD": 500,
    "ripeningDurationGDD": 200,
    "trussRipeningSpreadGDD": 100
  },

  "flowersPerTruss": { "mu": 5, "sigma": 1.0 },
  "fruitSetRate": 0.6,
  "potentialFruitMassG": { "mu": 200, "sigma": 25 },

  "morphology": {
    // Phytomer position of the first inflorescence (truss). Tomimaru
    // is an indeterminate beefsteak — first truss typically appears
    // around the 9th true leaf.
    "firstTrussNodeIdx": { "mu": 9, "sigma": 1.0 },

    // Successive trusses appear every 3 leaves (3-leaf phyllotaxis).
    "trussIntervalNodes": 3,

    // Transitional (Phase 2 → Phase 3): cap diameter for the legacy
    // visual sigmoid path. Phase 3 replaces this with mass-derived
    // diameter from CoreModel.freshMassToDiameter. Tomimaru 200g
    // beefsteak ≈ 80 mm equatorial diameter.
    "fruitMaxDiameterMm": { "mu": 82, "sigma": 8 },

    // Locule count — beefsteak ~6, range 4-10 (PMC10482247).
    "loculeCount": { "mu": 6.0, "sigma": 1.2 },

    // H:W ratio — Tomimaru is moderately oblate (< 1).
    "heightWidthRatio": { "mu": 0.72, "sigma": 0.09 },

    // Ribbing — Tomimaru is actually a *smooth* pink beefsteak (Sakata
    // markets it as elegant globe-shape). 0.55 made fruits look like
    // cauliflower; real Tomimaru shows only gentle shoulder lobes.
    "ribbingStrength": { "mu": 0.22, "sigma": 0.08 },

    "asymmetryStrength": 0.07,
    "blossomEndAdvanceFrac": { "mu": 0.45, "sigma": 0.1 }
  },

  "color": {
    // Pink beefsteak — lighter than standard red (Tomimaru breed character)
    "fullRipeRGB": [220, 90, 95],
    "greenStageRGB": [60, 130, 50],
    "hueVariance": 0.05
  },

  "pruning": {
    "defoliationAggressiveness": 0.32,
    // After natural set + abortion, retain 4 fruits per truss (basal first)
    "trussTargetFruitCount": 4
  },

  "physiology": {
    "SLA_m2_per_g": 0.028,
    // Per-organ sink strength (Marcelis 1996; fruit=1.0 baseline)
    "sinkStrength": {
      "leaf": 0.35,
      "stem": 0.15,
      "root": 0.07
    },
    // Iter 1A (2026-05-25): Gompertz curve was producing 80mm fruit by
    // day 30 (Reference Pack target: 0mm). gompertzInflectionC 0.45→0.55
    // delays τ from 292.5 GDD to 357.5 GDD post-fertilization (~+5 days).
    // gompertzRateB 0.06→0.05 slows asymptote approach. Citation:
    // Anaya-Ramirez 2024 fits cluster at τ/total 0.5-0.6, B 0.04-0.06.
    "gompertzRateB": 0.05,
    "gompertzInflectionC": 0.55
  },

  // ────────────────────────────────────────────────────────────────
  // Reproductive truss-order profile + management scenarios (v3.0 Phase 4)
  // ────────────────────────────────────────────────────────────────
  //
  // trussOrderProfile applies to each truss based on its 1-based
  // order along the main stem. First match wins. minOrder/maxOrder
  // are inclusive; maxOrder=null means "and above".
  //
  // scenarios.* override the cultivar baseline. ACTIVE_SCENARIO at
  // ModelRegistry decides which one is in effect at boot.
  "reproductive": {
    "trussOrderProfile": [
      { "minOrder": 1, "maxOrder": null,
        "flowersPerTruss": { "mu": 5, "sigma": 1.0 },
        "targetFruitCount": 4,
        "potentialMassMultiplier": 1.0 }
    ]
  },
  "scenarios": {
    "commercial-standard": {
      "metadata": {
        "label": "상업 단축 (200g × 4 적과)",
        "intendedUse": "production_like",
        "notForYieldPrediction": false
      },
      "management": {
        "fruitPruning":  { "enabled": true },
        // v4.2 — Korean commercial practice: bottom-up lower-leaf pruning.
        // Defoliation starts at D80, removes only y ≤ 0.50 m bed-near old leaves.
        // Iter 2 attempted (2026-05-25, growth_update_002):
        //   startDay 80→35 + removeBelowHeightM 0.50→0.60 + minLeafAgeDaysAtRemoval 30→21
        //   ROLLED BACK — caused S regression (0.652 → 0.626), removed leaves that
        //   reference still expected visible. See growth_update_002 outcome.
        //   Lesson: Reference Pack visibleLeafCount range (9-11 at day 30) is total
        //   visible leaves, but our model counts only leaves passing visibility.visible
        //   filter; aggressive defoliation makes sim < reference. Need to:
        //   (a) verify what Reference Pack "visibleLeafCount" means operationally, OR
        //   (b) loosen the defoliation while keeping lower-canopy management active.
        "defoliation":   { "enabled": true, "policy": "bottomUpHeight",
                           "startDay": 80, "removeBelowHeightM": 0.50, "minLeafAgeDaysAtRemoval": 30 },
        "harvest":       { "enabled": true, "atRipenStage": 5 }
      }
    },
    "visualPeakTruss": {
      "metadata": {
        "label": "데모: peak truss 6-8 과실 시각용",
        "intendedUse": "visual_validation_only",
        "notForYieldPrediction": true,
        "targetDays": [95, 100, 105]
      },
      "reproductive": {
        "trussOrderProfile": [
          { "minOrder": 1, "maxOrder": 3,
            "flowersPerTruss": { "mu": 5, "sigma": 1.0 },
            "targetFruitCount": 4, "potentialMassMultiplier": 1.0 },
          { "minOrder": 4, "maxOrder": 6,
            "flowersPerTruss": { "mu": 8, "sigma": 1.0 },
            "targetFruitCount": 7, "potentialMassMultiplier": 0.82 },
          { "minOrder": 7, "maxOrder": null,
            "flowersPerTruss": { "mu": 5, "sigma": 1.0 },
            "targetFruitCount": 4, "potentialMassMultiplier": 1.0 }
        ]
      },
      "management": {
        "fruitPruning":  { "enabled": false },
        "defoliation":   { "enabled": true, "keepTrussesAboveRedTopmost": 5, "keepLeavesPerTruss": 1 },
        "harvest":       { "enabled": false }
      }
    },
    "natural-no-management": {
      "metadata": {
        "label": "비교 baseline (적과/적엽/수확 OFF)",
        "intendedUse": "comparison_baseline",
        "notForYieldPrediction": true
      },
      "management": {
        "fruitPruning":  { "enabled": false },
        "defoliation":   { "enabled": false },
        "harvest":       { "enabled": false }
      }
    }
  },

  // Plant Morphology Engine — Leaf Module v0.1 (leafShape.v1).
  // estimated/low provenance — replace with measured values in M1 calibration.
  "leafShape": {
    "schemaVersion": "leafShape.v1",
    "provenance": {
      "sourceLevel": "estimated",
      "confidence": "low",
      "sourceRefs": [],
      "notes": "Tomimaru Muchoo: pink-beefsteak, mid-large leaflets, vigorous rachis.",
      "lastReviewed": "2026-05-25"
    },
    "widthProfile": {
      "mode": "beta",
      "peakHalfWidthM": 0.045,
      "peakT": 0.35,
      "sharpness": 4.5,
      "asymmetry": 1.0
    },
    "marginProfile": {
      "serrationDepth": 0.16,
      "serrationFrequency": 9,
      "lobeDepth": 0.07,
      "waviness": 0.05
    },
    "rachisLengthM": 0.32,
    "leafletAspect": 1.7
  }
}
