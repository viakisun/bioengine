// Cherry tomato — generic profile (literature-based).
// Small ~18g, ~2 locules, near-spherical, smooth surface.

{
  "metadata": {
    "name": "cherry-generic",
    "type": "cherry",
    "source": "literature",
    "references": [
      "PMC10482247 — locule QTL (fas, lc)",
      "Heuvelink 1996 — yield calibration"
    ]
  },

  "phenology": {
    "GDD_to_first_flower": 250,
    "GDD_per_truss": 120,
    "GDD_flower_to_red": 800,
    "cellDivisionDurationGDD": 150,
    "cellExpansionDurationGDD": 500,
    "ripeningDurationGDD": 200,
    "trussRipeningSpreadGDD": 60
  },

  "flowersPerTruss": { "mu": 12, "sigma": 3 },
  "fruitSetRate": 0.7,
  "potentialFruitMassG": { "mu": 18, "sigma": 4 },

  "morphology": {
    "firstTrussNodeIdx": { "mu": 8, "sigma": 1.0 },
    "trussIntervalNodes": 3,
    // Transitional. Cherry 18g ≈ 30 mm equatorial.
    "fruitMaxDiameterMm": { "mu": 30, "sigma": 3 },
    "loculeCount": { "mu": 2.0, "sigma": 0.3 },
    // Cherry tomatoes are near-spherical (H:W ~ 1.0)
    "heightWidthRatio": { "mu": 0.96, "sigma": 0.04 },
    // Very faint ribbing — cherries are smooth
    "ribbingStrength": { "mu": 0.05, "sigma": 0.05 },
    "asymmetryStrength": 0.05,
    "blossomEndAdvanceFrac": { "mu": 0.35, "sigma": 0.1 }
  },

  "color": {
    "fullRipeRGB": [195, 30, 22],
    "greenStageRGB": [34, 120, 30],
    "hueVariance": 0.04
  },

  "pruning": {
    "defoliationAggressiveness": 0.4,
    "trussTargetFruitCount": 10
  },

  "physiology": {
    "SLA_m2_per_g": 0.028,
    "sinkStrength": {
      "leaf": 0.35,
      "stem": 0.15,
      "root": 0.07
    },
    "gompertzRateB": 0.06,
    "gompertzInflectionC": 0.45
  },

  "reproductive": {
    "trussOrderProfile": [
      { "minOrder": 1, "maxOrder": null,
        "flowersPerTruss": { "mu": 12, "sigma": 3 },
        "targetFruitCount": 10, "potentialMassMultiplier": 1.0 }
    ]
  },
  "scenarios": {
    "commercial-standard": {
      "metadata": { "label": "Commercial cluster", "intendedUse": "production_like", "notForYieldPrediction": false },
      "management": {
        "fruitPruning":  { "enabled": true },
        "defoliation":   { "enabled": true, "keepTrussesAboveRedTopmost": 3, "keepLeavesPerTruss": 0 },
        "harvest":       { "enabled": true, "atRipenStage": 5 }
      }
    }
  },

  // Plant Morphology Engine — Leaf Module v0.1 (leafShape.v1).
  // estimated/low provenance — replace with measured values in M1 calibration.
  "leafShape": {
    "schemaVersion": "leafShape.v1",
    "provenance": {
      "sourceLevel": "estimated",
      "confidence": "low",
      "sourceRefs": [],
      "notes": "Cherry tomato: small, narrow leaflets. v0.1 골격값.",
      "lastReviewed": "2026-05-25"
    },
    "widthProfile": {
      "mode": "beta",
      "peakHalfWidthM": 0.030,
      "peakT": 0.33,
      "sharpness": 5.0,
      "asymmetry": 1.0
    },
    "marginProfile": {
      "serrationDepth": 0.18,
      "serrationFrequency": 10,
      "lobeDepth": 0.05,
      "waviness": 0.04
    },
    "rachisLengthM": 0.22,
    "leafletAspect": 2.2
  },

  // Botanical layer override (botanical.v1). Phase 1: empty — cherry uses
  // the default tomato botanical (ACTIVE_BOTANICAL.tomato) as-is. Future
  // calibration can populate fields here without touching engine code.
  "botanicalOverride": {},

  // Iter 29 Phase 1-Pre — cultivar growth profile (TT-based).
  // Schema: CultivarGrowthProfile in src/Cultivar.ts.
  // Cherry: smaller leaves (450-650 cm² range), fewer leaflets (7),
  // shorter internodes (5cm), thinner stem.
  // Missing fields fall back to type-default (cherry) then DEFAULT.
  "growthProfile": {
    "phyllochronTT": 38,                  // Heuvelink 1996
    "plastochronTT": 30,                   // v1 unused
    "baseInternodeLengthCm": 5,
    "maxLeafAreaCm2": 550,                 // cherry small
    "maxLeafletCount": 7,                  // cherry tends fewer
    "leafExpansionDurationTT": 380,        // slightly faster expansion
    "leafLifespanTT": 1100,
    "firstTrussNodeIndex": 8,
    "trussIntervalNodes": 3,
    "baseStemRadiusMm": 6,
    "sourceSinkSensitivity": 0.35,
    "droopSensitivity": 0.7                  // cherry rigid petiole, mild droop
  }
}
