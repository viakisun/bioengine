// Iter 29 Phase 6 — tomato-growth-targets.jsonc (NEW)
//
// Calibration band targets for tomato growth model. Each entry defines the
// acceptable measured range for a parameter at a specific TT (or day)
// checkpoint. Runtime assertWithinCalibrationBand emits a CalibrationWarning
// when an observed value falls outside the band.
//
// Plan §6 (sleepy-growing-pretzel.md) — CALIBRATION-01~04 + CALIBRATION-WARNING-01.
//
// Schema: CalibrationPackSpec in src/growth/CalibrationPack.ts.

{
  "schemaVersion": "calibrationPack.v0.1",
  "metadata": {
    "name": "tomato-growth-targets-v0.1",
    "crop": "tomato",
    "source": "Heuvelink 1996 TOMSIM + reference pack v0.1",
    "lastReviewed": "2026-05-30",
    "confidence": "medium"
  },

  // Per-phytomer leaf band targets (cultivar default = round-generic baseline).
  // ageTT-based — leaf age in GDD.
  "leaf": {
    "targetAreaCm2": {
      "ageTT": [
        { "tt": 0,    "min": 0,    "max": 5    },
        { "tt": 100,  "min": 5,    "max": 100  },
        { "tt": 200,  "min": 50,   "max": 350  },
        { "tt": 400,  "min": 300,  "max": 700  },
        { "tt": 800,  "min": 500,  "max": 850  },
        { "tt": 1200, "min": 400,  "max": 800  }
      ],
      "source": "Heuvelink 1996 — peak mature ~600-800 cm² medium tomato",
      "sourceRefs": ["Heuvelink 1996 TOMSIM"]
    },
    "leafletCount": {
      "ageTT": [
        { "tt": 0,    "min": 1, "max": 1 },
        { "tt": 100,  "min": 1, "max": 3 },
        { "tt": 200,  "min": 3, "max": 5 },
        { "tt": 400,  "min": 5, "max": 7 },
        { "tt": 600,  "min": 7, "max": 9 },
        { "tt": 1000, "min": 9, "max": 9 }
      ],
      "source": "Phyllome development progression"
    },
    "senescenceProgress": {
      "ageTT": [
        { "tt": 0,    "min": 0,   "max": 0.05 },
        { "tt": 600,  "min": 0,   "max": 0.10 },
        { "tt": 840,  "min": 0,   "max": 0.30 },
        { "tt": 1000, "min": 0.1, "max": 0.70 },
        { "tt": 1200, "min": 0.5, "max": 1.0  }
      ],
      "source": "senescenceStartTT = lifespanTT × 0.7 = 840 (default lifespan 1200)"
    }
  },

  // Plant-level band targets at canonical day checkpoints (D=15, 45, 90, 120).
  "plant": {
    "heightCm": {
      "day": [
        { "d": 15,  "min": 15,  "max": 30  },
        { "d": 45,  "min": 65,  "max": 110 },
        { "d": 90,  "min": 160, "max": 230 },
        { "d": 120, "min": 220, "max": 300 }
      ],
      "source": "greenhouse indeterminate cultivar canonical timeline"
    },
    "nodeCount": {
      "day": [
        { "d": 15,  "min": 5,  "max": 8  },
        { "d": 45,  "min": 8,  "max": 14 },
        { "d": 90,  "min": 18, "max": 26 },
        { "d": 120, "min": 24, "max": 32 }
      ],
      "source": "phyllochron 38 GDD/leaf at 23°C → ~1 leaf/3d"
    }
  },

  // Per-organ stem band targets.
  "stem": {
    "baseRadiusMm": {
      "day": [
        { "d": 15, "min": 2.0, "max": 4.0 },
        { "d": 45, "min": 5.0, "max": 8.5 },
        { "d": 90, "min": 7.5, "max": 11.0 }
      ],
      "source": "Greenhouse mature stem ~8 mm mid-shoot"
    }
  },

  // ── Iter 30 Phase 6 — Axis-level capacity band ────────────────────
  // Plan §3 axisCapacityFactor 검증 (CALIBRATION-AXIS-V2-01).
  // Main axis canonical: capacity 충분 → factor 1.0 근처. Side-shoot은
  // 약한 stem → 0.7~0.9 typical.
  "axis": {
    "mainAxisCapacityFactor": {
      "day": [
        { "d": 15, "min": 0.85, "max": 1.0 },
        { "d": 45, "min": 0.80, "max": 1.0 },
        { "d": 90, "min": 0.70, "max": 1.0 }
      ],
      "source": "main axis structural capacity proxy >= demand typical"
    },
    "sideShootAxisCapacityFactor": {
      "day": [
        { "d": 30, "min": 0.45, "max": 0.85 },
        { "d": 45, "min": 0.50, "max": 0.85 },
        { "d": 90, "min": 0.55, "max": 0.90 }
      ],
      "source": "side-shoot stem 더 얇음 → capacity proxy 낮음"
    }
  },

  // ── Iter 30 Phase 6 — Side-shoot leaf size band ──────────────────
  // Plan §6 SIDE-SHOOT-MEAN-LEAF-RATIO-01 검증 (CALIBRATION-SIDE-SHOOT-V2-01).
  "sideShoot": {
    "leafAreaCm2": {
      "ageTT": [
        { "tt": 0,    "min": 0,   "max": 5   },
        { "tt": 100,  "min": 5,   "max": 70  },
        { "tt": 400,  "min": 100, "max": 350 },
        { "tt": 800,  "min": 150, "max": 490 }
      ],
      "source": "side-shoot leaf < main leaf × 0.7 (cultivarSideShootPotential 0.4 default)"
    },
    "leafAreaMainRatio": {
      "day": [
        { "d": 30, "min": 0.2, "max": 0.7 },
        { "d": 45, "min": 0.2, "max": 0.7 },
        { "d": 90, "min": 0.2, "max": 0.7 }
      ],
      "source": "ageTT band 안에서 측지/메인 mean ratio (Plan SIDE-SHOOT-MEAN-LEAF-RATIO-01)"
    }
  },

  // ── Iter 30 Phase 6 — Leaf posture band ──────────────────────────
  // Plan §11 + Phase 5 9-필드 (CALIBRATION-POSTURE-V2-01).
  // 상부광 + young mature leaf: finalBladePlaneTiltDeg ≈ 0° (ground-parallel).
  // 큰 잎 + 노화: finalDroopDeg 25-45°.
  "posture": {
    "finalBladePlaneTiltDeg": {
      "ageTT": [
        { "tt": 0,    "min": 0,   "max": 5   },
        { "tt": 400,  "min": 0,   "max": 15  },
        { "tt": 800,  "min": 0,   "max": 30  },
        { "tt": 1200, "min": 5,   "max": 45  }
      ],
      "source": "상부광 0° → gravity + senescence droop 누적 → +로 tilt 증가"
    },
    "finalDroopDeg": {
      "ageTT": [
        { "tt": 0,    "min": 0,   "max": 5   },
        { "tt": 400,  "min": 5,   "max": 25  },
        { "tt": 800,  "min": 10,  "max": 35  },
        { "tt": 1200, "min": 20,  "max": 50  }
      ],
      "source": "gravity (현재 area↑) + senescence + waterStress 합산"
    }
  }
}
