{
  "name": "farmsim-root",
  "version": "0.1.0",
  "description": "스마트온실 디지털 트윈 + 토마토 학술 모델 튜닝 실험실 (Babylon.js + React)",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tsc:engine": "tsc -p packages/tomato-engine --noEmit",
    "tsc:geometry": "tsc -p packages/tomato-geometry --noEmit",
    "tomato:snapshot": "vite-node packages/tomato-engine/diagnostics/snapshot.ts --",
    "plant:dump": "vite-node src/plant/diagnostics/dumpPlantBase.ts --"
  },
  "dependencies": {
    "@babylonjs/core": "^9.8.0",
    "@babylonjs/gui": "^9.8.0",
    "@babylonjs/loaders": "^9.8.0",
    "@babylonjs/materials": "^9.8.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.8.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-node": "^6.0.0"
  }
}
